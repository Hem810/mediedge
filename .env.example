# MediEdge - Environment Configuration
# Copy this file to .env and customise as needed.
#
# NO API KEY REQUIRED - this app runs Gemma locally via Ollama.

# Ollama host (default works for local install)
OLLAMA_HOST=http://localhost:11434

# Which Gemma 4 model to use - must be pulled first via "ollama pull <name>"
# Options:
#   gemma4:e4b   - 4B params, runs on laptops with 8 GB RAM (default)
#   gemma4:31b   - 31B params, best quality, needs 32 GB RAM
OLLAMA_MODEL=gemma4:e4b

# Whisper STT model size for Hindi transcription
# Options: tiny / base / small / medium / large
# "small" gives the best balance of accuracy and speed for Hindi.
WHISPER_MODEL=small

# Server config (rarely changed)
HOST=localhost
PORT=8000
